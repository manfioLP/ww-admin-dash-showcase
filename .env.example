# ─── API Mode ─────────────────────────────────────────────────────────────────
# Set to "real" to use the Anthropic API, "mock" for simulated responses.
# When set to "mock" (or when ANTHROPIC_API_KEY is missing), the app uses
# built-in mock responses — no API key required, works fully offline.
NEXT_PUBLIC_API_MODE=mock

# ─── Anthropic API Key ────────────────────────────────────────────────────────
# Required only when NEXT_PUBLIC_API_MODE=real.
# Get your key at https://console.anthropic.com/
# The app will silently fall back to mock mode if this is missing.
ANTHROPIC_API_KEY=
